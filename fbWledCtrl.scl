FUNCTION_BLOCK "fbWledCtrl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
VAR_INPUT
    // No inputs currently required - logic based on InOut "WLED"
END_VAR

VAR_OUTPUT
    ERROR       : Bool;                                // Error flag (color index or buffer overflow)
    TriggerSend : Bool;                                // Trigger signal for communication block (TSEND)
    SendArray   : Array[0..#BUFFER_SIZE - 1] OF Char;  // Prepared JSON payload for WLED
    LEN         : Int;                                 // Exact length of the payload
END_VAR

VAR_IN_OUT
    WLED : "udtWlecCTRL"; // Up to MAX_STRIPES independently controllable LED zones
END_VAR

VAR
    sFirstCycle : Bool := TRUE;      // Internal flag for first scan initialization
    sColors     : Array[#COLOR_ARRAY_LOW..#COLOR_ARRAY_MAX] OF String[13]; // Static color table
    sStripesOld : Array[0..#MAX_STRIPES - 1] OF "udtWledStripe"; // Storage for edge detection
    instTimerUpdate {S7_SETPOINT := 'True'; InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME; // Cyclic update heartbeat
    sUpdate     : Bool;              // Internal trigger after watchdog timeout
END_VAR

VAR_TEMP
    tChanged     : Bool;             // Any stripe different from last cycle?
    tStripe      : Int;              // Loop index over stripes
    tFirstActive : Bool;             // Whether a "," separator is needed before the next seg object
    tNumStr      : String[16];       // Scratch string for VAL_STRG results
    tWritePos    : Int;              // Running write index into SendArray
    tOverflow    : Bool;             // Per-fragment overflow flag from fcBufAppend
    tAnyOverflow : Bool;             // OR of all tOverflow this cycle
    tSx          : USInt;            // Local copy of effect speed
    tIx          : USInt;            // Local copy of effect intensity
    tColor       : Array[0..2] OF USInt; // Mapped color indices
END_VAR

VAR CONSTANT
    MAX_STRIPES      : Int := 8;     // Number of independently controllable LED zones
    BUFFER_SIZE      : Int := 1200;  // SendArray size in bytes; keep in sync with fcBufAppend's bound
    COLOR_ARRAY_LOW  : USInt := 0;   // Lower bound of color lookup table
    COLOR_ARRAY_MAX  : USInt := 20;  // Upper bound of color lookup table
END_VAR


BEGIN
	(********************************************************************************
	* Block:       fbWledCtrl
	* Family:      Communication
	* Version:     V0.2.0
	* Author:      G. Jacob
	* Description: WLED multi-zone integration for S7-1200/1500 via JSON-UDP.
	*              Zones (Stripes) are defined entirely from the PLC side via
	*              Start/Len - nothing needs to be pre-configured in WLED itself.
	*              A zone with Len = 0 is simply not sent (if never used) or sent
	*              once with "stop":0 to make WLED delete it (if it was active
	*              and just got turned off/removed).
	********************************************************************************)
	// Supported Effects (Example IDs):
	// 0: Solid (1 Color)
	// 1: Blink (2 Color)
	// 2: Breathe (1 Color)
	// 45: Fire Flicker (1 Color)
	// 50: Two Dots (3 Colors)
	// 98: Percent (2 Colors)
	// 101: Loading

	REGION FirstCycle
	    // Initialize color lookup table on first scan
	    IF #sFirstCycle THEN
	        REGION Colors
	            #sColors[0]  := '[0,0,0]';       // OFF (Black)
	            #sColors[1]  := '[255,0,0]';     // Red (Error)
	            #sColors[2]  := '[0,255,0]';     // Green (OK)
	            #sColors[3]  := '[0,0,255]';     // Blue (Auto)
	            #sColors[4]  := '[255,255,0]';   // Yellow (Warning)
	            #sColors[5]  := '[255,165,0]';   // Orange
	            #sColors[6]  := '[0,255,255]';   // Cyan
	            #sColors[7]  := '[255,0,255]';   // Magenta
	            #sColors[8]  := '[255,255,255]'; // White (Neutral)
	            #sColors[9]  := '[255,240,200]'; // Warm White
	            #sColors[10] := '[128,0,255]';   // Violet
	            #sColors[11] := '[0,255,127]';   // Spring Green
	            #sColors[12] := '[255,20,147]';  // Deep Pink
	            #sColors[13] := '[173,216,230]'; // Light Blue
	            #sColors[14] := '[255,215,0]';   // Gold
	            #sColors[15] := '[128,128,128]'; // Grey
	            #sColors[16] := '[255,127,80]';  // Coral
	            #sColors[17] := '[0,128,128]';   // Teal
	            #sColors[18] := '[139,69,19]';   // Brown
	            #sColors[19] := '[75,0,130]';    // Indigo
	            #sColors[20] := '[255,255,255]'; // Reserve / Full Power
	        END_REGION
	    END_IF;
	END_REGION

	REGION Check New Data
	    // Heartbeat timer for cyclic update (Watchdog)
	    #instTimerUpdate.TON(IN:=NOT #sUpdate,
	                   PT:=T#1s,
	                   Q=>#sUpdate);

	    // ACHTUNG - bitte in TIA verifizieren: Vergleich von zwei Instanzen
	    // des gleichen STRUCT-Typs ("=") funktioniert nachweislich (siehe V0.1),
	    // hier nur pro Array-Element wiederholt statt auf dem ganzen Array.
	    #tChanged := FALSE;
	    FOR #tStripe := 0 TO #MAX_STRIPES - 1 DO
	        IF NOT (#WLED.Stripes[#tStripe] = #sStripesOld[#tStripe]) THEN
	            #tChanged := TRUE;
	        END_IF;
	    END_FOR;

	    // Detect changes or force update after 1s
	    IF NOT #tChanged AND NOT #sUpdate THEN
	        #TriggerSend := false;
	        RETURN;
	    END_IF;

	    // Reset update trigger and signal new transmission
	    RESET_TIMER(#instTimerUpdate);
	    #TriggerSend := true;
	END_REGION

	REGION Check Array Bounds
	    // Validate color indices to prevent CPU access errors
	    #ERROR := FALSE;
	    FOR #tStripe := 0 TO #MAX_STRIPES - 1 DO
	        IF #WLED.Stripes[#tStripe].Color[0] > #COLOR_ARRAY_MAX OR
	           #WLED.Stripes[#tStripe].Color[1] > #COLOR_ARRAY_MAX OR
	           #WLED.Stripes[#tStripe].Color[2] > #COLOR_ARRAY_MAX THEN
	            #ERROR := TRUE;
	        END_IF;
	    END_FOR;
	    IF #ERROR THEN
	        #TriggerSend := FALSE;
	        RETURN;
	    END_IF;
	END_REGION

	REGION Build JSON directly into SendArray
	    // Built fragment-by-fragment straight into the byte buffer instead of via one
	    // big STRING, because classic S7 STRING is hard-capped at 254 characters -
	    // too short for 8 zones worst-case (~1000 bytes). fcBufAppend bounds-checks
	    // every write; #tAnyOverflow is checked once at the end before anything is sent.
	    #tWritePos    := 0;
	    #tAnyOverflow := FALSE;
	    #tFirstActive := TRUE;

	    fcBufAppend(Frag:='{"seg":[', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	    #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	    FOR #tStripe := 0 TO #MAX_STRIPES - 1 DO

	        IF #WLED.Stripes[#tStripe].Len = 0 AND #sStripesOld[#tStripe].Len = 0 THEN
	            ; // Never used on WLED - nothing to say about this id, skip entirely
	        ELSE
	            IF NOT #tFirstActive THEN
	                fcBufAppend(Frag:=',', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	            END_IF;
	            #tFirstActive := FALSE;

	            fcBufAppend(Frag:='{"id":', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	            #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	            VAL_STRG(IN:=#tStripe, SIZE:=0, PREC:=0, FORMAT:=0, P:=1, OUT=>#tNumStr);
	            fcBufAppend(Frag:=#tNumStr, Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	            #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	            IF #WLED.Stripes[#tStripe].Len = 0 THEN
	                // Was active before, now cleared -> tell WLED to delete the segment
	                fcBufAppend(Frag:=',"stop":0}', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	            ELSE
	                VAL_STRG(IN:=#WLED.Stripes[#tStripe].Start, SIZE:=0, PREC:=0, FORMAT:=0, P:=1, OUT=>#tNumStr);
	                fcBufAppend(Frag:=',"start":', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                fcBufAppend(Frag:=#tNumStr, Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	                // WLED's "stop" is exclusive (= Start + Len)
	                VAL_STRG(IN:=#WLED.Stripes[#tStripe].Start + #WLED.Stripes[#tStripe].Len, SIZE:=0, PREC:=0, FORMAT:=0, P:=1, OUT=>#tNumStr);
	                fcBufAppend(Frag:=',"stop":', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                fcBufAppend(Frag:=#tNumStr, Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	                IF NOT #WLED.Stripes[#tStripe].Power THEN
	                    fcBufAppend(Frag:=',"on":false}', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                ELSE
	                    // Per-stripe color remap (effect-specific layouts, e.g. 50 "Two Dots")
	                    #tColor[0] := #WLED.Stripes[#tStripe].Color[0];
	                    #tColor[1] := #WLED.Stripes[#tStripe].Color[1];
	                    #tColor[2] := #WLED.Stripes[#tStripe].Color[2];

	                    CASE #WLED.Stripes[#tStripe].Effect.No OF
	                        50: // Two Dots: Rearrange colors for specific effect logic
	                            #tColor[1] := #WLED.Stripes[#tStripe].Color[0];
	                            #tColor[2] := #WLED.Stripes[#tStripe].Color[1];
	                            #tColor[0] := #WLED.Stripes[#tStripe].Color[2]; // Background

	                            // Fallback for dark pixels
	                            IF #tColor[1] = 0 THEN #tColor[1] := #tColor[0]; END_IF;
	                            IF #tColor[2] = 0 THEN #tColor[2] := #tColor[0]; END_IF;
	                    END_CASE;

	                    #tSx := #WLED.Stripes[#tStripe].Effect.Sx;
	                    #tIx := #WLED.Stripes[#tStripe].Effect.Ix;
	                    IF #tSx = 0 THEN #tSx := 128; END_IF;
	                    // Intensity handling: 0 is valid for percent effect (98), otherwise default to 128
	                    IF #tIx = 0 AND #WLED.Stripes[#tStripe].Effect.No <> 98 THEN
	                        #tIx := 128;
	                    END_IF;

	                    fcBufAppend(Frag:=',"on":true,"fx":', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    VAL_STRG(IN:=#WLED.Stripes[#tStripe].Effect.No, SIZE:=0, PREC:=0, FORMAT:=0, P:=1, OUT=>#tNumStr);
	                    fcBufAppend(Frag:=#tNumStr, Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	                    fcBufAppend(Frag:=',"sx":', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    VAL_STRG(IN:=#tSx, SIZE:=0, PREC:=0, FORMAT:=0, P:=1, OUT=>#tNumStr);
	                    fcBufAppend(Frag:=#tNumStr, Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	                    fcBufAppend(Frag:=',"ix":', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    VAL_STRG(IN:=#tIx, SIZE:=0, PREC:=0, FORMAT:=0, P:=1, OUT=>#tNumStr);
	                    fcBufAppend(Frag:=#tNumStr, Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	                    fcBufAppend(Frag:=',"col":[', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    fcBufAppend(Frag:=#sColors[#tColor[0]], Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    fcBufAppend(Frag:=',', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    fcBufAppend(Frag:=#sColors[#tColor[1]], Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    fcBufAppend(Frag:=',', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    fcBufAppend(Frag:=#sColors[#tColor[2]], Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                    fcBufAppend(Frag:=']}', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	                    #tAnyOverflow := #tAnyOverflow OR #tOverflow;
	                END_IF;
	            END_IF;
	        END_IF;
	    END_FOR;

	    fcBufAppend(Frag:=']}', Pos:=#tWritePos, Buffer:=#SendArray, Overflow=>#tOverflow);
	    #tAnyOverflow := #tAnyOverflow OR #tOverflow;

	    IF #tAnyOverflow THEN
	        // Worst case for 8 full zones is ~1000 bytes against a 1200 byte buffer,
	        // so this should never trigger in normal operation - if it does, BUFFER_SIZE
	        // (and fcBufAppend's matching literal) need to grow.
	        #ERROR       := TRUE;
	        #TriggerSend := FALSE;
	        RETURN;
	    END_IF;

	    #LEN := #tWritePos;
	END_REGION

	REGION Housekeeping
	    // Store current state for next cycle's comparison
	    #sStripesOld := #WLED.Stripes;
	    #sFirstCycle := false;
	END_REGION
END_FUNCTION_BLOCK
